#!/usr/bin/env bash
# check-affected <body.md>: the PR body's "Other features affected" table and Open PRs line are complete (/pr step 4).
# PASS: a table follows "**Other features affected:**" (rows may continue in a <details> fold whose summary starts
# "Other features affected"), every row has 3 cells (Feature | What changes for it | Proof) with a proof and a change
# of nothing / intended: / side effect: / unknown:, a "No other features" row says nothing and shows the grep that
# found 0, each side effect's feature is named in the Review ask, and a non-empty "**Open PRs:**" line exists.
# One file:line: problem. Fix: ... per line, exit 1 on any.
set -u
[ $# -eq 1 ] || { echo "usage: check-affected <body.md>"; exit 2; }
[ -r "$1" ] || { echo "$1: cannot read"; exit 2; }
awk -v f="$1" '
  function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
  function bad(n, msg) { printf "%s:%d: %s\n", f, n, msg; err=1 }
  /^\*\*Review ask:\*\*/ { ask=$0 }
  /^\*\*Open PRs:\*\*/ { open=1; rest=$0; sub(/^\*\*Open PRs:\*\*/, "", rest); if (trim(rest) == "") openblank=1; mode=0; next }
  /^\*\*Other features affected:\*\*/ || /<summary>Other features affected/ { found=1; mode=1; head=1; next }
  mode && /^[ \t]*$/ { next }
  mode && /^\|/ {
    if (head) { head=0; next }                     # header row
    if ($0 ~ /^\|[ :|-]+$/) next                   # separator row
    rows++
    line=$0; gsub(/\\\|/, "\001", line)            # an escaped pipe stays inside its cell
    sub(/^\|/, "", line); sub(/\|[ \t]*$/, "", line)
    k=split(line, c, "|")
    for (i=1; i<=k; i++) { gsub(/\001/, "|", c[i]); c[i]=trim(c[i]) }
    if (k != 3) { bad(NR, "row needs 3 cells (Feature | What changes for it | Proof), got " k ". Fix: write it as | <feature> | <what changes> | <proof> |, escaping a pipe inside a cell as \\|."); next }
    if (c[3] == "") { bad(NR, "\"" c[1] "\" has no proof. Fix: name the test run, search or snapshot comparison, with its result."); next }
    ch=c[2]
    if (c[1] ~ /^No other features/) {
      if (ch != "nothing") bad(NR, "\"No other features\" must say nothing in What changes for it. Fix: write nothing, or replace this row with one row per affected feature.")
      else if (c[3] !~ /grep/ || c[3] !~ /(^|[^0-9])0([^0-9]|$)/) bad(NR, "\"No other features\" without the search that found 0. Fix: put the git grep command and its 0 hits in Proof, and run the same search on the base to show it finds the definition.")
    } else if (ch ~ /^(intended|side effect|unknown):/) {
      if (trim(substr(ch, index(ch, ":") + 1)) == "") bad(NR, "\"" ch "\" says nothing after the colon. Fix: say what changes for the feature, or why it is unknown.")
      else if (ch ~ /^side effect:/) side[++ns]=c[1]
    } else if (ch != "nothing") {
      bad(NR, "\"" ch "\" is not one of: nothing, intended: <change>, side effect: <change>, unknown: <why>. Fix: use one of those.")
    }
    next
  }
  mode { mode=0 }
  END {
    if (!found) { printf "%s: no \"**Other features affected:**\" table. Fix: run /pr step 2\047s Other features affected pass and put its table under Merge danger.\n", f; exit 1 }
    if (!rows) { printf "%s: the Other features affected table has no rows. Fix: run /pr step 2\047s Other features affected pass; every feature outside the spec that uses changed code gets a row, or one No other features row showing the search.\n", f; err=1 }
    for (i=1; i<=ns; i++) if (!index(ask, side[i])) { printf "%s: side effect on \"%s\" is not in the Review ask. Fix: name %s and its side effect in the **Review ask:** line.\n", f, side[i], side[i]; err=1 }
    if (!open) { printf "%s: no \"**Open PRs:**\" line. Fix: run /pr step 2\047s open-PR pass and write its result on an **Open PRs:** line under Merge danger.\n", f; err=1 }
    else if (openblank) { printf "%s: the **Open PRs:** line is empty. Fix: write no conflicts, conflicts: <files> per PR, or none open with the empty gh pr list.\n", f; err=1 }
    exit err
  }' "$1"
