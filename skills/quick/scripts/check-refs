#!/usr/bin/env bash
# check-refs [skills dir]: /quick cites /spec and /direct items by number (quick/SKILL.md).
# Each cited item must still sit at that number and start with the bold lead it had when cited.
# One file:line: problem. Fix: ... per line, exit 1 on any; unreadable file: exit 2.
set -u
root=${1:-$(cd "$(dirname "$0")/../.." && pwd)}
quick=$root/quick/SKILL.md
out=""
# want <skill> <section> <number> <bold lead> [text the item must also contain]
want() {
  local f=$root/$1/SKILL.md got
  [ -r "$f" ] || { echo "$f: cannot read"; exit 2; }
  got=$(awk -v sec="$2" -v n="$3" '
    /^## / { in_=(substr($0, 4) == sec); next }
    in_ && index($0, n ". ") == 1 { print NR "\t" $0; exit }' "$f")
  if [ -z "$got" ]; then
    out+="$f:1: no item $3 under \"## $2\", but $quick cites it. Fix: update the number $quick cites, or restore item $3."$'\n'
  elif [[ ${got#*$'\t'} != "$3. $4"* ]]; then
    out+="$f:${got%%$'\t'*}: item $3 under \"## $2\" no longer starts \"$4\", which $quick cites. Fix: point $quick at the item's new number, or restore it."$'\n'
  elif [ -n "${5:-}" ] && [[ $got != *"$5"* ]]; then
    out+="$f:${got%%$'\t'*}: item $3 under \"## $2\" no longer mentions \"$5\", which $quick relies on. Fix: update $quick to match, or restore it."$'\n'
  fi
}
want spec "Hard rules" 3 "**Every AC is testable"
want spec "Hard rules" 4 "**No file paths"
want spec "Hard rules" 5 "**Status stays"
want spec Steps 3 "**Write**" "spec checks:"
want direct Steps 1 "**Gate.**"
want direct Steps 3 "**Read first.**"
want direct Steps 7 "**Hand off.**" "/final-review"
[ -z "$out" ] || { printf '%s' "$out"; exit 1; }
