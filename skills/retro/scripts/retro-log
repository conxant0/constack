#!/usr/bin/env python3
import collections, json, os, re, sys
from pathlib import Path

worktree = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else os.getcwd())
projects = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "projects"
name = re.sub(r"[^A-Za-z0-9]", "-", worktree)
main = projects / name
if not main.is_dir():
    print("no logs on this machine")
    sys.exit(0)

sessions = sorted(main.glob("*.jsonl"))
folders = [main] + [
    p for p in sorted(projects.iterdir())
    if p.is_dir() and any(f"{name}-{s.stem}-scratchpad" in p.name for s in sessions)
]


def rows(path):
    for line in path.open(errors="replace"):
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if isinstance(row, dict):
            yield row


def text(content):
    if isinstance(content, str):
        return content
    return " ".join(b.get("text", "") for b in content if isinstance(b, dict))


def strip(t):
    t = re.sub(r"\b(?=\w*[A-Za-z])(?=\w*\d)\w+\b", "", t)
    t = re.sub(r"\d+", "", t)
    return " ".join(t.split())


errors = collections.Counter()
for folder in folders:
    for log in sorted(folder.glob("*.jsonl")) + sorted(folder.glob("*/subagents/*.jsonl")):
        for row in rows(log):
            content = (row.get("message") or {}).get("content") if row.get("type") == "user" else None
            if isinstance(content, list):
                for block in content:
                    if isinstance(block, dict) and block.get("type") == "tool_result" and block.get("is_error"):
                        errors[strip(text(block.get("content") or ""))] += 1

def tag(t, name):
    m = re.search(rf"<{name}>(.*?)</{name}>", t, re.S)
    return m.group(1).strip() if m else ""


def typed(row):
    if row.get("entrypoint") == "sdk-cli" or row.get("turnOrigin") == "scheduled":
        return None
    queued = row.get("attachment") if row.get("type") == "attachment" else None
    if isinstance(queued, dict) and queued.get("type") == "queued_command":
        if (queued.get("origin") or {}).get("kind") != "human":
            return None
        return text(queued.get("prompt") or "").strip() or None
    if row.get("type") != "user" or row.get("isMeta") or row.get("isSidechain") or row.get("isCompactSummary"):
        return None
    content = (row.get("message") or {}).get("content")
    if isinstance(content, list) and any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
        return None
    t = text(content or "").strip()
    if t.startswith("[Request interrupted"):
        return None
    if t.startswith("<") and not t.startswith("<pasted_content"):
        if tag(t, "command-name"):
            return f"{tag(t, 'command-name')} {tag(t, 'command-args')}".strip()
        if tag(t, "bash-input"):
            return f"! {tag(t, 'bash-input')}"
        return None
    return t or None


messages = sorted(
    (row.get("timestamp", ""), msg)
    for log in sessions for row in rows(log) if (msg := typed(row))
)


def key(msg):
    return " ".join(re.sub(r"[^\w\s]", "", msg.lower()).split()) or msg.strip()


typed_counts = collections.Counter(key(msg) for _, msg in messages)
seen = set()

print("## Repeated errors")
for err, n in [(e, n) for e, n in errors.most_common() if n >= 2][:5]:
    print(f"{n}x {err}")
print("## Typed messages")
for _, msg in messages:
    k = key(msg)
    if k not in seen:
        seen.add(k)
        n = typed_counts[k]
        print(f"{n}x {msg}" if n >= 2 else msg)
