#!/usr/bin/env bash
# review-lanes <index.md> <base-ref> [--only wording] [--wording-tests "<shell command>"]
# Runs final review's script lanes together: full suite, clean-checkout suite, wording.
set -u
here=$(cd "$(dirname "$0")" && pwd)
. "$here/test-re.sh"

index=${1:-}; base=${2:-}
only="" wtests=""
shift 2 2>/dev/null
while [ $# -gt 0 ]; do
  case "$1" in
    --only) only=${2:-}; shift 2 2>/dev/null || shift ;;
    --wording-tests) wtests=${2:-}; shift 2 2>/dev/null || shift ;;
    *) echo "ERROR review-lanes: unknown argument $1. Fix: use review-lanes <index.md> <base-ref> [--only wording] [--wording-tests \"<shell command>\"]."; exit 2 ;;
  esac
done
if [ -n "$only" ] && [ "$only" != wording ]; then
  echo "ERROR review-lanes: --only $only is not a lane. Fix: use --only wording."; exit 2
fi
if [ -z "$index" ] || [ -z "$base" ] || [ ! -f "$index" ]; then
  echo "ERROR review-lanes: usage: review-lanes <index.md> <base-ref>. Fix: pass an existing index.md and the review's BASE (or PREV)."
  exit 2
fi
root=$(git -C "$(dirname "$index")" rev-parse --show-toplevel 2>/dev/null) || {
  echo "ERROR $index: not inside a git repo. Fix: pass the index.md of the branch under review."; exit 2; }
cmd=$(sed -n 's/^Test command:[[:space:]]*//p' "$index" | head -1 | tr -d '`')
if [ -z "$cmd" ]; then
  echo "ERROR $index: no \"Test command:\" line. Fix: add the full suite command to the index (slice assets/index-template.md)."
  exit 2
fi

tmp=$(cd "$(mktemp -d "${TMPDIR:-/tmp}/review-lanes.XXXXXX")" && pwd -P)
cleanup() {
  git -C "$root" worktree list --porcelain | sed -n 's/^worktree //p' | while IFS= read -r w; do
    case "$w" in "$tmp"/*) git -C "$root" worktree remove --force "$w" 2>/dev/null ;; esac
  done
  rm -rf "$tmp"
  git -C "$root" worktree prune
}
trap cleanup EXIT
trap 'jobs -p | xargs kill 2>/dev/null; exit 2' INT TERM

includes=""
[ -f "$root/.worktreeinclude" ] &&
  includes=$(cd "$root" && git ls-files -oi --exclude-from=.worktreeinclude --directory)

env_files="" link_paths=""
while IFS= read -r p; do
  [ -n "$p" ] || continue
  p=${p%/}
  case "$(basename "$p")" in
    .env*) env_files="$env_files$p"$'\n' ;;
    *) link_paths="$link_paths$p"$'\n' ;;
  esac
done <<<"$includes"

names=""
while IFS= read -r p; do
  [ -n "$p" ] && [ -f "$root/$p" ] && names="$names
$(sed -nE 's/^(export )?([A-Za-z_][A-Za-z0-9_]*)=.*/\2/p' "$root/$p")"
done <<<"$env_files"
[ -f "$HOME/.claude/checks/clean-suite-env" ] && names="$names
$(cat "$HOME/.claude/checks/clean-suite-env")"
names=$(printf '%s\n' "$names" | sed '/^[[:space:]]*$/d' | sort -u)

stamp() { date +%s > "$tmp/$1.$2"; }

lane_full() {
  stamp full start
  (cd "$root" && bash -c "$cmd") > "$tmp/full.out" 2>&1
  echo $? > "$tmp/full.rc"
  stamp full end
}

lane_clean() {
  stamp clean start
  local c=$tmp/clean unset_args=() p n
  {
    git -C "$root" worktree add -q --detach "$c" HEAD || { echo 2 > "$tmp/clean.rc"; stamp clean end; return; }
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      mkdir -p "$(dirname "$c/$p")"
      ln -s "$root/$p" "$c/$p"
    done <<<"$link_paths"
    while IFS= read -r n; do [ -n "$n" ] && unset_args+=(-u "$n"); done <<<"$names"
    (cd "$c" && env ${unset_args[@]+"${unset_args[@]}"} bash -c "$cmd")
    echo $? > "$tmp/clean.rc"
  } > "$tmp/clean.out" 2>&1
  stamp clean end
}

lane_wording() {
  stamp wording start
  local changed w=$tmp/wording p files=()
  changed=$(git -C "$root" diff --name-only --diff-filter=AM "$base"...HEAD -- '*.py' | grep -Ev "$test_re")
  if [ -z "$changed" ]; then
    echo 0 > "$tmp/wording.rc"
  else
    while IFS= read -r p; do files+=("$p"); done <<<"$changed"
    {
      git -C "$root" worktree add -q --detach "$w" HEAD || { echo 2 > "$tmp/wording.rc"; stamp wording end; return; }
      while IFS= read -r p; do
        [ -n "$p" ] || continue
        mkdir -p "$(dirname "$w/$p")"
        ln -s "$root/$p" "$w/$p"
      done <<<"$link_paths$env_files"
      (cd "$w" && "$here/mutate-copy" --base "$base" "${files[@]}" -- bash -c "${wtests:-$cmd}")
      echo $? > "$tmp/wording.rc"
    } > "$tmp/wording.out" 2>&1
  fi
  stamp wording end
}

if [ "$only" = wording ]; then
  lanes=wording
  lane_wording
else
  lanes="full clean wording"
  lane_full & lane_clean & lane_wording &
  wait
fi

status=0
for l in $lanes; do
  rc=$(cat "$tmp/$l.rc" 2>/dev/null || echo 2)
  if [ "$rc" = 0 ]; then r=PASS; else r=FAIL; status=1; fi
  if [ "$l" = wording ] && [ "$rc" != 0 ]; then
    if [ "$rc" = 1 ]; then r=SURVIVED; else r=COULD-NOT-RUN; fi
  fi
  h="LANE $l: $r start=$(cat "$tmp/$l.start") end=$(cat "$tmp/$l.end")"
  [ "$l" = clean ] && h="$h unset=$(printf '%s\n' "$names" | paste -sd, -)"
  echo "$h"
  if [ "$r" = COULD-NOT-RUN ]; then
    { tail -1 "$tmp/$l.out" 2>/dev/null
      echo "Fix: re-run review-lanes $index $base --only wording --wording-tests \"<the tests covering those files, with -x and --deselect per snapshot file>\""
    } | sed 's/^/  /'
  elif [ "$l" = wording ] && [ -f "$tmp/$l.out" ]; then
    grep -E '^SURVIVED |^[0-9]+ sentences' "$tmp/$l.out" | sed 's/^/  /'
  elif [ "$r" = FAIL ] && [ -f "$tmp/$l.out" ]; then
    body=$(grep -E '^(FAILED|ERROR|FAIL)[ :]' "$tmp/$l.out" | head -40)
    [ -n "$body" ] || body=$(tail -20 "$tmp/$l.out")
    printf '%s\n' "$body" | sed 's/^/  /'
  fi
done
exit $status
