#!/usr/bin/env bash
# wf <subcommand> ...: deterministic checks for /spec, /slice, /build, /direct, /final-review.
#   wf base                  The branch this repo's features merge into, as origin/<branch>: git config
#                            constack.base, else origin/HEAD. Its source goes to stderr. Neither: exit 2.
#   wf frontier <index.md>   todo tickets whose blockers are all done, one id per line.
#                            None runnable: "all done" (exit 0), or each unfinished ticket
#                            with its status (exit 1). Malformed index: file:line: problem (exit 2).
#   wf chains <index.md>     "Chain: T02 > T03 > T04" per chain (/build rule 7): each next ticket's
#                            blockers all sit earlier in the chain, and every ticket but the last
#                            has no dependents outside it. Single tickets are not printed.
#   wf waves <index.md>      Waves (the most tickets on one blocked-by path), that longest path with each
#                            edge's reason (interface, file, shares, test file, no reason), the tickets
#                            in each wave, and a Note for a wave wider than /build's 5 at once. Exit 0;
#                            malformed index or cycle: exit 2.
#   wf check-plan <index.md>  /slice output is well formed: index has Spec/Branch/Base/Test command;
#                            ticket ids unique, blockers exist, no cycles; one tickets/<id>-*.md
#                            per row and no extras; each ticket has Spec, Blocked by (same as the
#                            index) and every template section with content. Two tickets listing
#                            the same file must have a blocked-by path between them, unless one is done. Every
#                            blocked-by edge between unfinished tickets needs a reason: a Consumes line naming the
#                            blocker, or a Files entry both list (a "- shares: table:<name>" line counts; two test:
#                            entries for one file do not). An unfinished ticket's Interfaces "- Consumes" line
#                            must have the colon right after "Consumes", or the reason above is unreadable. Every Delivers
#                            AC has a ### Tests heading naming it, and Delivers AC lines match
#                            <index dir>/spec.md word for word (MISSING / DRIFT). One
#                            file:line: problem per line, exit 1 on any.
#   wf check-spec <spec.md>   /spec rules: Status draft|approved, Branch, Base, Date; stories US-1, US-2...
#                            in order; their ACs US-n.AC1, AC2... in order (a letter suffix like AC7b
#                            may follow AC7); each AC has Given, when, then; no OPEN: once approved;
#                            Out of Scope and Manual check have content; no file paths (dir/file.ext).
#                            One file:line: problem per line, exit 1 on any.
#   wf questions <index.md>  /direct's "## Open questions" section exists and says "none" or lists "- Qn: ..." lines,
#                            each with "Answer: <answer>" on its line. One file:line: problem. Fix: ... per line, exit 1 on any.
#   wf parts <index.md>      /direct's "## Parts": one "- Pn: <AC ids>; files: <paths>" line per table row, every
#                            AC in <index dir>/spec.md in exactly one part. One file:line: problem. Fix: ... per line, exit 1 on any.
#   wf entry '<raw argument>' /direct's argument, one argv with its literal quotes: first word (after one opening ")
#                            an existing file prints "spec" (AFK after it is fine); a word ending .md that is no file,
#                            no argument, or a task with a word AFK after its closing quote (or last, unquoted): exit 1
#                            with a Fix:. Else prints "task". Two or more argv: exit 2.
#   wf gate <spec|index.md> [--build|--final|--slice|--direct|--task]
#                            Current branch is the file's Branch: and the tree is clean.
#                            --slice and --direct (spec): Status: approved and wf check-spec clean. --task: same,
#                            plus at most 3 ACs (lettered ones count). Each new line ends with a Fix:.
#                            --build: settings allow git, check-red-green.sh and wf (skip in auto or
#                            bypass mode), and every ignored venv / node_modules / .env is listed in
#                            .worktreeinclude. --final: every ticket in the index next to it is done.
#                            One problem per line, exit 1 on any.
#   wf scope <index.md> [head]
#                            Files changed in Base...head (default HEAD) that no ticket's Files
#                            section lists (a listed path ending in / covers everything under it).
#                            The plan's own folder is exempt. One path per line, exit 1 on any.
#   wf red <spec.md> [head]   Every spec AC (lettered ones like AC7b too) has a commit whose subject is
#                            exactly "test(<id>): red" or "test(<id>): guard" in Base..head (Base from the spec, head
#                            default HEAD). One file:line: problem per AC without one, exit 1 on any.
#   wf lead <index.md> [head] /direct's orchestrator wrote no AC code: its own commits (first-parent, non-merge, in
#                            Base..head) hold no "<type>(US-n.ACm): ..." subject and change at most 40 lines outside the
#                            index's folder. One file:line: problem. Fix: ... per line, exit 1 on any.
#   wf size <index.md> [head] Non-test files changed in Base...head that cross 1000 lines, or were already
#                            over 1000 and grew by more than 100. One path: before -> after per file, exit 1 on any.
#   wf check-review <review.md> [head]
#                            /final-review's review.md agrees with itself. PASS: every spec AC has a row
#                            (rows like "US-1.AC1 to AC4, AC6" or "US-3.AC1-AC4" count), no row says no under Test checks
#                            the AC, no Verify row says fail or not run, Fix tickets and OPEN are none or absent (an "overruled by hand" PASS may keep
#                            OPEN). Full suite is not judged: a PASS may record baseline failures. FAIL: Fix tickets
#                            or OPEN is not none. Either verdict: no row says partly, a no row's Note starts "Mutation:", the Range end is a sha, an ancestor of head (default
#                            HEAD), and nothing but docs, *.md or tests changed since; each such line names "Range end". One file:line: problem. Fix: ... per line, exit 1 on any.
#   wf set <index.md> <id> todo|doing|"blocked: <reason>"
#   wf done <index.md> <id> <merge sha>
#   wf ruling <index.md> "<ticket or stage>: <ruling, why>"
#                            Edit the index (status cell, or a dated line under ## Rulings) and
#                            commit only index.md. Exit 2 on a bad id, status, sha or index.
#   wf mode delivers|wording|guard-patch
#                            The check's mode, warn or block: <check>=<mode> in $CHECKS_CONF, else
#                            skills/build/checks.conf; missing file or name: delivers=block, others warn.
#                            Exit 0; unknown check or a value other than warn or block: exit 2.
#   wf warn-log <feature-dir> <check> <ticket-id> "<subject>: <text>"
#                            Append "<check> <ticket-id> <subject>: <text>" to <feature-dir>/check-warnings.log
#                            unless that exact line is already there. Exit 0.
set -u
. "$(cd "$(dirname "$0")" && pwd)/test-re.sh"
. "$(cd "$(dirname "$0")" && pwd)/ac-covered.sh"

tickets() { # id<TAB>blockers<TAB>status<TAB>line, from the index's ticket table
  awk -F'|' -v f="$1" '
    $2 ~ /^ *[A-Z][0-9]+ *$/ {
      if (NF < 6) { printf "%s:%d: ticket row needs 4 columns\n", f, NR > "/dev/stderr"; bad=1; next }
      id=$2; b=$(NF-2); s=$(NF-1)
      gsub(/^ +| +$/, "", id); gsub(/^ +| +$/, "", b); gsub(/^ +| +$/, "", s)
      gsub(/ /, "", b)
      printf "%s\t%s\t%s\t%d\n", id, b, s, NR
    }
    END { exit bad }' "$1"
}

load() { # rows=ticket rows of index $1, or exit 2 on an unreadable or malformed index
  [ -r "$1" ] || { echo "$1: cannot read"; exit 2; }
  rows=$(tickets "$1") || exit 2
  [ -n "$rows" ] || { echo "$1: no ticket rows"; exit 2; }
  printf '%s\n' "$rows" | awk -F'\t' -v f="$1" '
    { id[NR]=$1; bl[NR]=$2; ln[NR]=$4; seen[$1]=1 }
    END {
      for (i=1; i<=NR; i++) if (bl[i] != "none") {
        n=split(bl[i], b, ",")
        for (j=1; j<=n; j++) if (!(b[j] in seen)) { printf "%s:%d: %s blocked by unknown ticket %s\n", f, ln[i], id[i], b[j]; bad=1 }
      }
      exit bad
    }' || exit 2
}

frontier() {
  local rows; load "$1"
  printf '%s\n' "$rows" | awk -F'\t' '
    { id[NR]=$1; bl[NR]=$2; st[NR]=$3; done_[$1]=($3 ~ /^done /) }
    END {
      for (i=1; i<=NR; i++) {
        if (st[i] != "todo") continue
        ok=1
        if (bl[i] != "none") { n=split(bl[i], b, ","); for (j=1; j<=n; j++) if (!done_[b[j]]) ok=0 }
        if (ok) { print id[i]; any=1 }
      }
      if (any) exit 0
      for (i=1; i<=NR; i++) if (!done_[id[i]]) { printf "%s %s\n", id[i], st[i]; left=1 }
      if (!left) { print "all done"; exit 0 }
      exit 1
    }'
}

chains() {
  local rows; load "$1"
  printf '%s\n' "$rows" | awk -F'\t' '
    { id[NR]=$1; nb[NR]=($2 == "none") ? 0 : split($2, b, ",")
      for (j=1; j<=nb[NR]; j++) { blk[NR, j]=b[j]; deps[b[j]]=deps[b[j]] " " $1 } }
    function inside(x,   k) { for (k=1; k<=len; k++) if (c[k] == x) return 1; return 0 }
    function fits(i,   j) { # every blocker of ticket i is already in the chain
      if (!nb[i]) return 0
      for (j=1; j<=nb[i]; j++) if (!inside(blk[i, j])) return 0
      return 1
    }
    END {
      for (s=1; s<=NR; s++) {
        if (used[id[s]]) continue
        len=1; c[1]=id[s]; used[id[s]]=1
        while (1) { # grow while exactly one unused ticket fits
          nc=0
          for (i=1; i<=NR; i++) if (!used[id[i]] && fits(i)) { nc++; pick=i }
          if (nc != 1) break
          c[++len]=id[pick]; used[id[pick]]=1
        }
        for (k=1; k<len; k++) { # cut after the first ticket with a dependent outside the chain
          n=split(deps[c[k]], d, " ")
          for (j=1; j<=n; j++) if (!inside(d[j])) { for (m=k+1; m<=len; m++) used[c[m]]=0; len=k; k=0; break }
        }
        if (len < 2) continue
        line="Chain: " c[1]; for (k=2; k<=len; k++) line=line " > " c[k]; print line
      }
    }'
}

SECTIONS="Delivers|Files|Interfaces|Tests|Approach|Constraints|Verify|Out of scope"

edges() { # edges <index>, after load: per blocked-by edge, id blocker kind detail ticket-file line either-done (TAB-separated)
  local dir; dir=$(dirname "$1")
  set -- "$dir"/tickets/*.md; [ -e "$1" ] || set --
  printf '%s\n' "$rows" | awk -F'\t' '
    NR == FNR { if (NF) { ids[++n]=$1; bl[$1]=$2; isdone[$1]=($3 ~ /^done /) }; next }
    FNR == 1 { id=FILENAME; sub(/.*\//, "", id); sub(/-.*/, "", id); sec=""; file[id]=FILENAME }
    /^Blocked by:/ { bln[id]=FNR }
    /^## / { sec=substr($0, 4); next }
    function add(p, v) { if (p == "") return; lists[id, p]=1; if (v != "test") nontest[id, p]=v; path[id]=path[id] "\n" p }
    sec == "Files" && /^- [a-z]/ { v=$0; sub(/^- /, "", v); sub(/[^a-z].*/, "", v)
      if (v == "shares") { p=$0; sub(/^[^:]*: */, "", p); gsub(/`/, "", p); sub(/ .*/, "", p); add(p, v) }
      else { m=split($0, w, /[ ,`()]+/) # every path on the line: "- modify, only if ...: a/b.py, c/d.json"
        for (k=1; k<=m; k++) { p=w[k]; sub(/[.:;]+$/, "", p); if (p ~ /\// || p ~ /[A-Za-z0-9_]\.[A-Za-z0-9]+$/) add(p, v) } } }
    sec == "Interfaces" && /^- / { inc=($0 ~ /^- Consumes:/) }
    sec == "Interfaces" && inc { cons[id]=cons[id] " " $0 }
    function kind(u, b,   m, k, p, t, ps) {
      if (!(u in file)) return "no ticket file\t"
      if (cons[u] ~ "(^|[^A-Za-z0-9])" b "([^0-9]|$)") return "interface\t"
      m=split(path[u], ps, "\n")
      for (k=2; k<=m; k++) { p=ps[k]; if (!lists[b, p]) continue
        if ((u, p) in nontest || (b, p) in nontest) return (nontest[u, p] == "shares" ? "shares" : "file") "\t" p
        if (t == "") t=p }
      return t != "" ? "test file\t" t : "no reason\t"
    }
    END { for (i=1; i<=n; i++) { u=ids[i]; if (bl[u] == "none") continue
      m=split(bl[u], b, ",")
      for (j=1; j<=m; j++) if (b[j] in bl) printf "%s\t%s\t%s\t%s\t%d\t%d\n", u, b[j], kind(u, b[j]), file[u], bln[u], (isdone[u] || isdone[b[j]]) } }' - "$@"
}

waves() {
  local rows; load "$1"
  { printf '%s\n' "$rows"; printf '\f\n'; edges "$1"; } | awk -F'\t' -v f="$1" '
    $0 == "\f" { e=1; next }
    !e { if (NF) { ids[++n]=$1; bl[$1]=$2 }; next }
    { k[$1, $2]=$3; d[$1, $2]=$4 }
    function depth(u,   m, j, b, x, best) {
      if (u in dp) return dp[u]
      if (on[u]) { printf "%s: blocked-by cycle through %s. Fix: run wf check-plan and break the cycle.\n", f, u; bad=1; exit 2 }
      on[u]=1; best=0
      if (bl[u] != "none") { m=split(bl[u], b, ","); for (j=1; j<=m; j++) { x=depth(b[j]); if (x > best) { best=x; via[u]=b[j] } } }
      on[u]=0; dp[u]=best + 1; return dp[u]
    }
    END {
      if (bad) exit 2
      for (i=1; i<=n; i++) { x=depth(ids[i]); if (x > w) { w=x; last=ids[i] }; at[x]=at[x] " " ids[i]; cnt[x]++ }
      if (bad) exit 2
      p=last
      for (u=last; u in via; u=via[u]) p=via[u] " > " u " (" k[u, via[u]] (d[u, via[u]] != "" ? " " d[u, via[u]] : "") ")" substr(p, length(u) + 1)
      printf "Waves: %d\nLongest path: %s\n", w, p
      for (x=1; x<=w; x++) printf "Wave %d:%s\n", x, at[x]
      for (x=1; x<=w; x++) if (cnt[x] > 5) printf "Note: wave %d has %d tickets and /build runs at most 5 at once, so %d waits for a free slot.\n", x, cnt[x], cnt[x] - 5
    }'
}

check_plan() {
  local f=$1 dir rows err id n t files
  [ -r "$f" ] || { echo "$f: cannot read"; exit 2; }
  dir=$(dirname "$f")
  {
    awk -v f="$f" '
      /^(Spec|Branch|Base|Test command): *[^ ]/ { k=$0; sub(/:.*/, "", k); has[k]=1 }
      END { split("Spec Branch Base Test_command", w, " ")
            for (i=1; i<=4; i++) { k=w[i]; gsub(/_/, " ", k); if (!has[k]) printf "%s:1: missing \"%s:\" line\n", f, k } }' "$f"
    err=$(mktemp) || exit 2
    rows=$(tickets "$f" 2>"$err"); cat "$err"; rm -f "$err"
    [ -n "$rows" ] || echo "$f:1: no ticket rows"
    printf '%s\n' "$rows" | awk -F'\t' -v f="$f" '
      NF { if ($1 in ln) printf "%s:%d: ticket %s listed twice\n", f, $4, $1
           id[++n]=$1; ln[$1]=$4; nb[$1]=($2 == "none") ? 0 : split($2, b, ",")
           for (j=1; j<=nb[$1]; j++) blk[$1, j]=b[j] }
      function visit(u,   j, v) {
        color[u]=1
        for (j=1; j<=nb[u]; j++) { v=blk[u, j]
          if (color[v] == 1 && !cyc) { printf "%s:%d: blocked-by cycle through %s and %s\n", f, ln[u], u, v; cyc=1 }
          else if (!color[v]) visit(v) }
        color[u]=2
      }
      END {
        for (i=1; i<=n; i++) for (j=1; j<=nb[id[i]]; j++) if (!(blk[id[i], j] in ln)) { printf "%s:%d: %s blocked by unknown ticket %s\n", f, ln[id[i]], id[i], blk[id[i], j]; bad=1 }
        if (!bad) for (i=1; i<=n; i++) if (!color[id[i]]) visit(id[i])
      }'
    printf '%s\n' "$rows" | while IFS=$'\t' read -r id b _ n; do
      [ -n "$id" ] || continue
      set -- "$dir/tickets/$id"-*.md
      if [ ! -e "$1" ]; then echo "$f:$n: $id has no ticket file tickets/$id-*.md"; continue; fi
      [ $# -eq 1 ] || { echo "$f:$n: $id has $# ticket files"; continue; }
      awk -v id="$id" -v want="$b" -v secs="$SECTIONS" '
        BEGIN { ns=split(secs, sec, "|") }
        /^Spec: *[^ ]/ { spec=1 }
        /^Blocked by:/ { got=$0; sub(/^Blocked by: */, "", got); gsub(/ /, "", got); bl=FNR }
        /^## / { cur=substr($0, 4); at[cur]=FNR; next }
        cur != "" && /[^ ]/ { body[cur]=1 }
        END {
          if (!spec) printf "%s:1: missing \"Spec:\" line\n", FILENAME
          if (!bl) printf "%s:1: missing \"Blocked by:\" line\n", FILENAME
          else {
            n1=split(got, g, ","); n2=split(want, w, ","); same=(n1 == n2)
            for (i=1; i<=n2; i++) inw[w[i]]=1
            for (i=1; i<=n1; i++) if (!(g[i] in inw)) same=0
            if (!same) printf "%s:%d: Blocked by %s, index says %s\n", FILENAME, bl, got, want
          }
          for (i=1; i<=ns; i++) {
            if (!(sec[i] in at)) printf "%s:1: missing section \"## %s\"\n", FILENAME, sec[i]
            else if (!body[sec[i]]) printf "%s:%d: section \"## %s\" is empty\n", FILENAME, at[sec[i]], sec[i]
          }
        }' "$1"
    done
    set -- "$dir"/tickets/*.md; [ -e "$1" ] || set --
    [ -r "$dir/spec.md" ] || echo "$f:1: no spec.md next to the index"
    printf '%s\n' "$rows" | awk -F'\t' 'NF { printf "%s:%s:%s\n", $1, $2, $3 }' | awk -v spec="$dir/spec.md" -v AC='US-[0-9]+[.]AC[0-9]+[a-z]?' '
      NR == FNR { split($0, kv, ":"); nb=split(kv[2], b, ","); for (j=1; j<=nb; j++) if (b[j] != "none") reach[kv[1], b[j]]=1; ids[kv[1]]=1; isdone[kv[1]]=(kv[3] ~ /^done /); next }
      FILENAME == spec { spec_ok=1; if ($0 ~ "^- " AC ":") { inspec[$0]=1; specln[$0]=FNR; specorder[++ns]=$0 }; next }
      FNR == 1 { id=FILENAME; sub(/.*\//, "", id); sub(/-.*/, "", id); sec="" }
      /^## / { sec=substr($0, 4); next }
      sec == "Delivers" && $0 ~ "^- " AC ":" {
        intix[$0]=1; if (spec_ok && !($0 in inspec)) printf "%s:%d: DRIFT: AC line not in spec.md word for word\n", FILENAME, FNR
        a=$0; sub(/^- /, "", a); sub(/:.*/, "", a); want[FILENAME, a]=FNR; wantf[FILENAME]=1; acs[FILENAME]=acs[FILENAME] " " a }
      sec == "Files" && /^- [a-z]+: / { p=$0; sub(/^- [a-z]+: */, "", p); gsub(/`/, "", p); sub(/ .*/, "", p)
        if (p != "") { k=++nf; fid[k]=id; fpath[k]=p; ffile[k]=FILENAME; fln[k]=FNR } }
      sec == "Tests" && /^### / { tests[FILENAME]=tests[FILENAME] " " $0 " " }
      function covered(fn, a,   s, e, re) { s=tests[fn]; e=a; gsub(/[.]/, "[.]", e); re="[^A-Za-z0-9.]" e "[^A-Za-z0-9]"; return s ~ re }
      END {
        for (fn in wantf) { n=split(acs[fn], x, " "); for (i=1; i<=n; i++) if (!covered(fn, x[i])) printf "%s:%d: %s has no ### Tests heading naming it\n", fn, want[fn, x[i]], x[i]
          t=fn; sub(/.*\//, "", t); sub(/-.*/, "", t)
          if (n > 4 && !isdone[t]) printf "%s:%d: %s delivers %d ACs, max 4: split it (red-green runs Verify once per AC)\n", fn, want[fn, x[1]], t, n }
        if (spec_ok) for (i=1; i<=ns; i++) if (!(specorder[i] in intix)) printf "%s:%d: MISSING: AC in no ticket'"'"'s Delivers\n", spec, specln[specorder[i]]
        for (u in ids) for (v in ids) for (w in ids) if (reach[v, u] && reach[u, w]) reach[v, w]=1  # ponytail: O(n^3) closure, fine for tens of tickets
        for (i=1; i<=nf; i++) for (j=i+1; j<=nf; j++) {
          u=fid[i]; v=fid[j]
          if (u == v || isdone[u] || isdone[v] || fpath[i] != fpath[j] || reach[u, v] || reach[v, u] || seen[u, v, fpath[i]]++) continue
          printf "%s:%d: %s shares %s with %s, but neither is blocked by the other\n", ffile[j], fln[j], v, fpath[i], u
        }
      }' - $([ -r "$dir/spec.md" ] && printf '%q' "$dir/spec.md") "$@"
    [ -z "$rows" ] || edges "$f" | awk -F'\t' '$7 == 0 && $3 == "no reason" { printf "%s:%d: %s is blocked by %s with no stated reason. Fix: name what %s Consumes from %s (a ticket that runs last writes '"'"'- Consumes: the merged work of %s (runs last: <why>)'"'"'), or add the same '"'"'- shares: <table|route|config>:<name>'"'"' line to both tickets'"'"' Files, or drop %s from %s'"'"'s Blocked by (index and ticket).\n", $5, $6, $1, $2, $1, $2, $2, $2, $1 }
      $7 == 0 && $3 == "test file" { printf "%s:%d: %s is blocked by %s only because both add tests to %s. Fix: give %s its own new test file, then drop %s from %s'"'"'s Blocked by (index and ticket).\n", $5, $6, $1, $2, $4, $1, $2, $1 }'
    for t in "$dir"/tickets/*.md; do
      [ -e "$t" ] || continue
      id=${t##*/}; id=${id%%-*}
      printf '%s\n' "$rows" | cut -f1 | grep -qFx -- "$id" || echo "$t:1: $id is not in the index table"
      printf '%s\n' "$rows" | awk -F'\t' -v id="$id" '$1 == id && $3 ~ /^done / { d=1 } END { exit !d }' && continue
      awk -v t="$t" '/^## / { sec=substr($0, 4); next }
        sec == "Interfaces" && /^- Consumes([^:]|$)/ { printf "%s:%d: a Consumes line needs a colon right after \"Consumes\", or wf cannot read which ticket it names. Fix: write it as '"'"'- Consumes: <signature> from T0n (<path>)'"'"'.\n", t, FNR }' "$t"
    done
  } > "${tmp:=$(mktemp)}"
  cat "$tmp"; [ ! -s "$tmp" ]; n=$?; rm -f "$tmp"; exit $n
}

check_spec() {
  [ -r "$1" ] || { echo "$1: cannot read"; exit 2; }
  local out
  out=$(awk -v f="$1" '
    function p(n, msg) { printf "%s:%d: %s\n", f, n, msg }
    /^Status: (draft|approved) *$/ { status=$2 }
    /^(Branch|Base|Date): *[^ <]/ { k=$0; sub(/:.*/, "", k); has[k]=1 }
    /^## / { sec=substr($0, 4); sub(/ +$/, "", sec); at[sec]=NR; next }
    sec != "" && /[^ ]/ { body[sec]=1 }
    /OPEN:/ { open_[++no]=NR }
    /^### US-[0-9]+ / { n=$2; sub(/^US-/, "", n); n+=0
      if (n != story + 1) p(NR, "US-" n " out of order, want US-" story + 1 " here")
      story=n; ac=0; next }
    /^- US-[0-9]+[.]AC[0-9]+[a-z]?:/ {
      id=$2; sub(/:$/, "", id); s_=id; sub(/^US-/, "", s_); sub(/[.].*/, "", s_)
      m=id; sub(/.*AC/, "", m); suf=m; sub(/[0-9]+/, "", suf); m+=0
      if (s_ + 0 != story) p(NR, id " sits under story US-" story)
      if (id in seen) p(NR, id " appears twice")
      seen[id]=1
      if (suf == "" && m != ac + 1) p(NR, id " out of order, want AC" ac + 1 " here")
      if (suf != "" && m != ac) p(NR, id " does not follow AC" m)
      if (suf == "") ac=m
      if (tolower($0) !~ /given/ || tolower($0) !~ /when/ || tolower($0) !~ /then/) p(NR, id " is not Given / when / then")
    }
    /[A-Za-z0-9_.-]+\/[A-Za-z0-9_.\/-]+[.][a-z][a-z0-9]?[a-z0-9]?[a-z0-9]?([^a-z0-9]|$)/ && !/:\/\// && !/^(Branch|Base):/ { p(NR, "file path (rule 4: no file paths)") }
    END {
      if (!status) p(1, "missing \"Status: draft|approved\" line")
      split("Branch Base Date", w, " ")
      for (i=1; i<=3; i++) if (!has[w[i]]) p(1, "missing \"" w[i] ":\" line")
      if (status == "approved") for (i=1; i<=no; i++) p(open_[i], "OPEN: in an approved spec")
      if (!story) p(1, "no ### US-n stories")
      split("Out of Scope|Manual check", w, "|")
      for (i=1; i<=2; i++) if (!(w[i] in at)) p(1, "missing section \"## " w[i] "\""); else if (!body[w[i]]) p(at[w[i]], "section \"## " w[i] "\" is empty")
    }' "$1")
  [ -z "$out" ] || { printf '%s\n' "$out"; exit 1; }
}

gate() {
  local f=$1 mode=${2:-} dir root want ln cur rule need have p
  [ -r "$f" ] || { echo "$f: cannot read"; exit 2; }
  dir=$(dirname "$f")
  root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || { echo "$f: not in a git repo"; exit 2; }
  {
    ln=$(grep -n -m1 '^Branch:' "$f" | cut -d: -f1)
    want=$(sed -n "${ln:-0}s/^Branch: *//p" "$f" | tr -d '`' | sed 's/ *$//')
    cur=$(git -C "$root" branch --show-current)
    if [ -z "$want" ]; then echo "$f:1: missing \"Branch:\" line"
    elif [ "$cur" != "$want" ]; then echo "$f:$ln: on branch ${cur:-(detached)}, want $want"; fi
    [ -z "$(git -C "$root" status --porcelain | cut -c4- | grep -vE '(^|/)check-warnings\.log$')" ] || echo "$root: uncommitted changes (git status --porcelain is not empty)"
    if [ "$mode" = --slice ] || [ "$mode" = --direct ] || [ "$mode" = --task ]; then
      ln=$(grep -n -m1 '^Status:' "$f" | cut -d: -f1)
      rule=$(sed -n "${ln:-0}s/^Status: *//p" "$f" | sed 's/ *$//')
      p=/${mode#--}; [ "$mode" != --task ] || p=/direct
      [ "$rule" = approved ] || echo "$f:${ln:-1}: Status is ${rule:-missing}, $p needs approved. Fix: answer every OPEN: line, set Status: approved, commit, re-run."
      have=$(check_spec "$f") || { printf '%s\n' "$have"; echo "$f:1: wf check-spec failed (lines above). Fix: correct each line in the spec, commit, re-run."; }
    fi
    if [ "$mode" = --task ]; then
      need=$(grep -cE '^- US-[0-9]+[.]AC[0-9]+[a-z]?:' "$f")
      [ "$need" -le 3 ] || echo "$f:1: $need ACs, a one-line task takes at most 3 for /direct. Fix: use the grilled path (/grill-me, /spec, then /direct $f)."
    fi
    if [ "$mode" = --final ]; then
      if [ "$(frontier "$dir/index.md" 2>&1)" != "all done" ]; then
        have=
        if grep -q '^## Parts' "$dir/index.md" && [ ! -e "$dir/tickets" ]; then
          have=$(git -C "$root" log --format='%H %s' "$(base_ref "$dir/index.md")..HEAD" 2>/dev/null | awk -v f="$dir/index.md" '
            NR == FNR { if ($3 == "doing") { id[++n]=$1; ln[n]=$4 }; next }
            { for (i=1; i<=n; i++) if (index($0, " merge " id[i] ":") == 41 && !(id[i] in got)) got[id[i]]=substr($1, 1, 8) }
            END { for (i=1; i<=n; i++) if (id[i] in got) printf "%s:%d: %s is merged (%s) but still doing. Fix: finish the no-ticket build (lead check, quality review, full suite), then run wf done %s %s %s.\n", f, ln[i], id[i], got[id[i]], f, id[i], got[id[i]] }
          ' FS='\t' <(tickets "$dir/index.md") FS=' ' -)
        fi
        [ -n "$have" ] && printf '%s\n' "$have" || echo "$dir/index.md:1: not every ticket is done (run /build)"
      fi
    fi
    if [ "$mode" = --build ]; then
      for rule in 'Bash(git:*)' 'Bash(${CLAUDE_SKILL_DIR}/scripts/check-red-green.sh:*)' 'Bash(${CLAUDE_SKILL_DIR}/scripts/wf:*)'; do
        cat "$root/.claude/settings.json" "$root/.claude/settings.local.json" 2>/dev/null | grep -qF -- "\"$rule\"" ||
          echo "$root/.claude/settings.local.json: missing allow rule \"$rule\" (fine in auto or bypass mode)"
      done
      need=$(git -C "$root" ls-files -oi --exclude-standard --directory | grep -E '(^|/)(\.?venv[^/]*|node_modules|\.env[^/]*)/?$')
      have=$( [ -r "$root/.worktreeinclude" ] && git -C "$root" ls-files -oi --exclude-from=.worktreeinclude --directory)
      printf '%s\n' "$need" | while IFS= read -r p; do
        [ -n "$p" ] || continue
        printf '%s\n' "$have" | grep -qFx -- "$p" || echo "$root/.worktreeinclude: add $p (ignored, so new worktrees lack it)"
      done
    fi
  } > "${tmp:=$(mktemp)}"
  cat "$tmp"; [ ! -s "$tmp" ]; p=$?; rm -f "$tmp"; exit $p
}

repo_base() { # the branch this repo's features merge into, as origin/<branch>; its source goes to stderr
  local b
  if b=$(git config --get constack.base); then
    printf 'origin/%s\n' "${b#origin/}"; echo "wf base: from git config constack.base" >&2
  elif b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s\n' "$b"; echo "wf base: from origin/HEAD (git config constack.base <branch> overrides it)" >&2
  else
    echo "wf base: no base branch: constack.base is unset and origin/HEAD is missing. Fix: git config constack.base <branch>, or git remote set-head origin --auto"
    exit 2
  fi
}

base_ref() { # first word of the Base: line, so "Base: origin/main (a86a89d5)" gives origin/main
  awk '/^Base:/ { gsub(/`/, ""); print $2; exit }' "$1"
}

scope() {
  local f=$1 head=${2:-HEAD} dir root base plan changed listed
  [ -r "$f" ] || { echo "$f: cannot read"; exit 2; }
  dir=$(dirname "$f")
  root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || { echo "$f: not in a git repo"; exit 2; }
  base=$(base_ref "$f")
  [ -n "$base" ] || { echo "$f:1: missing \"Base:\" line"; exit 2; }
  changed=$(git -C "$root" diff --name-only "$base...$head") || { echo "git diff $base...$head failed"; exit 2; }
  plan=$(cd "$dir" && git rev-parse --show-prefix)
  listed=$(awk '/^## / { sec=substr($0, 4); next }
    sec == "Files" && /^- [a-z]+: / { p=$0; sub(/^- [a-z]+: */, "", p); gsub(/`/, "", p); sub(/ .*/, "", p); if (p != "") print p }' "$dir"/tickets/*.md 2>/dev/null)
  printf '%s\n' "$changed" | awk -v plan="$plan" '
    NR == FNR { if ($0 != "") listed[++n]=$0; next }
    $0 == "" || index($0, plan) == 1 { next }
    { for (i=1; i<=n; i++) if ($0 == listed[i] || (listed[i] ~ /\/$/ && index($0, listed[i]) == 1)) next
      print $0 ": changed, but no ticket lists it under Files"; bad=1 }
    END { exit bad }' <(printf '%s\n' "$listed") -
}

size() {
  local f=$1 head=${2:-HEAD} root base a d p after before bad=0
  [ -r "$f" ] || { echo "$f: cannot read"; exit 2; }
  root=$(git -C "$(dirname "$f")" rev-parse --show-toplevel 2>/dev/null) || { echo "$f: not in a git repo"; exit 2; }
  base=$(base_ref "$f")
  [ -n "$base" ] || { echo "$f:1: missing \"Base:\" line"; exit 2; }
  while read -r a d p; do
    [ "$a" = - ] && continue
    case $p in *test*|*.json|*.md|*.lock) continue ;; esac
    after=$(git -C "$root" show "$head:$p" 2>/dev/null | wc -l | tr -d ' ') || continue
    [ "$after" -gt 0 ] || continue
    before=$((after - a + d))
    if { [ "$before" -le 1000 ] && [ "$after" -gt 1000 ]; } || { [ "$before" -gt 1000 ] && [ $((a - d)) -gt 100 ]; }; then
      echo "$p: $before -> $after lines"; bad=1
    fi
  done < <(git -C "$root" diff --numstat "$base...$head")
  return $bad
}

red() {
  local f=$1 head=${2:-HEAD} root base subjects
  [ -r "$f" ] || { echo "$f: cannot read"; exit 2; }
  root=$(git -C "$(dirname "$f")" rev-parse --show-toplevel 2>/dev/null) || { echo "$f: not in a git repo"; exit 2; }
  base=$(base_ref "$f")
  [ -n "$base" ] || { echo "$f:1: missing \"Base:\" line"; exit 2; }
  subjects=$(git -C "$root" log --format=%s "$base..$head") || { echo "git log $base..$head failed"; exit 2; }
  local n id out
  out=$(ac_uncovered "$subjects" "$f") && return 0
  while read -r n id; do
    printf '%s:%d: %s has no "test(%s): red" or guard commit in %s\n' "$f" "$n" "$id" "$id" "$base..$head"
  done <<<"$out"
  return 1
}

lead() {
  local f=$1 head=${2:-HEAD} root base out plan n bad=0
  [ -r "$f" ] || { echo "$f: cannot read"; exit 2; }
  root=$(git -C "$(dirname "$f")" rev-parse --show-toplevel 2>/dev/null) || { echo "$f: not in a git repo"; exit 2; }
  base=$(base_ref "$f")
  [ -n "$base" ] || { echo "$f:1: missing \"Base:\" line"; exit 2; }
  out=$(git -C "$root" log --reverse --first-parent --no-merges --format='%h %s' --abbrev=8 "$base..$head") || { echo "git log $base..$head failed"; exit 2; }
  printf '%s\n' "$out" | awk -v f="$f" '$2 ~ /^[a-z]+\(US-[0-9]+[.]AC[0-9]+[a-z]?\)/ { s=$0; sub(/^[^ ]* /, "", s)
    printf "%s:1: commit %s \"%s\" is the lead'"'"'s own AC commit. Fix: hand AC work to a helper and merge the helper'"'"'s branch with a merge commit (git merge --no-ff).\n", f, $1, s; bad=1 }
    END { exit bad }' || bad=1
  plan=$(cd "$(dirname "$f")" && git rev-parse --show-prefix)
  n=$(git -C "$root" log --first-parent --no-merges --numstat --format= "$base..$head" | awk -v plan="$plan" '$1 != "-" && index($3, plan) != 1 { n += $1 + $2 } END { print n + 0 }')
  [ "$n" -le 40 ] || { echo "$f:1: the lead's own commits change $n lines outside $plan, limit 40. Fix: hand the work to a helper and merge its branch with a merge commit (git merge --no-ff)."; bad=1; }
  return $bad
}

check_review() {
  local f=$1 head=${2:-HEAD} root spec end ln changed out log doneids lf=()
  [ -r "$f" ] || { echo "$f: cannot read"; exit 2; }
  log=$(dirname "$f")/check-warnings.log; [ -s "$log" ] && lf=("$log")
  doneids=$(tickets "$(dirname "$f")/index.md" 2>/dev/null | awk -F'\t' '$3 ~ /^done / {printf "%s ", $1}')
  root=$(git -C "$(dirname "$f")" rev-parse --show-toplevel 2>/dev/null) || { echo "$f: not in a git repo"; exit 2; }
  spec=$(awk '/^Spec:/ { gsub(/`/, ""); print $2; exit }' "$f")
  out=$(awk -v f="$f" -v logf="$log" -v doneids="$doneids" -v spec="$root/$spec" -v specname="$(basename "${spec:-spec.md}")" -v AC='US-[0-9]+[.]AC[0-9]+[a-z]?' '
    function p(n, msg) { printf "%s:%d: %s\n", f, n, msg }
    function first(sec, want) { return !(sec in at) || tolower(body[sec]) ~ ("^" want) }
    FILENAME == logf { if ($0 != "") lg[++nl]=$0; next }
    BEGIN { n=split(doneids, d, " "); for (i=1; i<=n; i++) done[d[i]]=1 }
    NR == FNR && FILENAME == spec { if (match($0, "^- " AC ":")) { id=substr($0, 3, RLENGTH - 3); sids[++ns]=id; sln[id]=FNR }; next }
    /^Verdict:/ && !vln { vln=FNR; verdict=$2; overruled=($0 ~ /overruled by hand/) }
    /^Range:/ && !rln { rln=FNR }
    /^## / { sec=substr($0, 4); sub(/ +$/, "", sec); at[sec]=FNR; next }
    /^### / { if (sec == "Verify" && $0 ~ "^### US-") {} else next }
    sec != "" && /[^ ]/ && !(sec in body) { body[sec]=$0; bln[sec]=FNR }
    sec == "Check warnings" && /^- / { cw[++ncw]=substr($0, 3); cwln[ncw]=FNR }
    sec == "Acceptance criteria" && /^\| *US-/ {
      split($0, cell, "|"); gsub(/-AC/, " to AC", cell[2]); n=split(cell[2], tk, /[ ,]+/); story=""; last=""
      for (i=1; i<=n; i++) {
        t=tk[i]
        if (t ~ /^US-[0-9]+[.]AC[0-9]+[a-z]?$/) { story=t; sub(/[.].*/, "", story); id=t }
        else if (t ~ /^AC[0-9]+[a-z]?$/ && story != "") id=story "." t
        else if (t == "to") { range=1; continue }
        else continue
        row[id]=1
        if (range && last != "") { lo=last; sub(/.*AC/, "", lo); hi=id; sub(/.*AC/, "", hi); for (k=lo+0; k<=hi+0; k++) num[story, k]=1 }
        range=0; last=id
      }
      w=cell[4]; gsub(/^ +| +$/, "", w)
      x=cell[2]; gsub(/^ +| +$/, "", x)
      if (tolower(w) == "partly") p(FNR, x " says \"" w "\" under Test checks the AC. Fix: grade the row yes or no (step 4): no when a production change makes the AC false and its tests still pass, else yes.")
      if (verdict == "PASS" && tolower(w) == "no") p(FNR, x " says \"" w "\" under Test checks the AC, but Verdict is PASS. Fix: set Verdict: FAIL and write an F ticket for it (step 8).")
      if (tolower(w) == "no" && cell[5] !~ /^ *Mutation:/) p(FNR, x " says \"" w "\" under Test checks the AC, but its Note does not start with \"Mutation:\". Fix: start the Note with \"Mutation: <patch file beside this review>; <the test command that still passed>\", or grade the row yes.")
    }
    sec == "Verify" && $0 ~ "^(### )?US-[0-9]+[.]AC[^:]*: *(fail|not run)" && verdict == "PASS" {
      w=$0; sub(/^[^:]*: */, "", w); w=(w ~ /^fail/) ? "fail" : "not run"
      p(FNR, "Verify row says " w ", but Verdict is PASS. Fix: " (w == "fail" ? "set Verdict: FAIL and write an F ticket citing this row (step 8)." : "put it under OPEN and set Verdict: FAIL; the user decides (step 6b)."))
    }
    END {
      if (!vln) { p(1, "missing \"Verdict:\" line. Fix: write review.md from assets/review-template.md."); exit }
      if (verdict == "PASS") {
        for (i=1; i<=ns; i++) { id=sids[i]; nm=id; sub(/.*AC/, "", nm); st=id; sub(/[.].*/, "", st)
          if (!(id in row) && !num[st, nm + 0]) p(at["Acceptance criteria"] ? at["Acceptance criteria"] : 1, id " (" specname ":" sln[id] ") has no row in the AC table. Fix: judge it (step 4) and add its row; a PASS needs every AC.") }
        if (!first("Fix tickets", "none")) p(bln["Fix tickets"] ? bln["Fix tickets"] : 1, "Fix tickets is not none, but Verdict is PASS. Fix: set Verdict: FAIL (step 8 builds them), or mark a declined structure finding declined and remove its ticket.")
        if (!overruled && !first("OPEN", "none")) p(bln["OPEN"] ? bln["OPEN"] : 1, "OPEN is not none, but Verdict is PASS. Fix: set Verdict: FAIL and stop: OPEN items are the user'"'"'s (step 8).")
      } else if (first("Fix tickets", "none") && first("OPEN", "none"))
        p(vln, "Verdict is FAIL, but Fix tickets and OPEN are both none. Fix: list the F tickets step 8 writes, or the OPEN items for the user.")
      for (i=1; i<=nl; i++) { L=lg[i]; g=0
        for (j=1; j<=ncw && !g; j++) if (index(cw[j], L) == 1 && substr(cw[j], length(L) + 1) ~ /^ (real|false alarm): .+/) g=j
        if (!g) p(at["Check warnings"] ? at["Check warnings"] : 1, "check warning not graded: " L ". Fix: add \"- " L " real: <reason> (F<nn>)\" or \"- " L " false alarm: <reason>\" under ## Check warnings.")
        else if (substr(cw[g], length(L) + 1) ~ /^ real: / && match(cw[g], /\(fixed in [^)]+\)$/) ) { if (!(substr(cw[g], RSTART + 10, RLENGTH - 11) in done)) p(cwln[g], "check warning fixed-in names no done ticket: " L ". Fix: name a ticket the index records done, or grade it real: <reason> (F<nn>) with a fix ticket.") }
        else if (substr(cw[g], length(L) + 1) ~ /^ real: / && substr(cw[g], length(L) + 1) !~ /^ real: .+\(F[0-9]+\)/) p(cwln[g], "check warning graded real names no fix ticket: " L ". Fix: end the row with (F<nn>), the fix ticket step 8 writes for it.") }
    }' $([ -n "$spec" ] && [ -r "$root/$spec" ] && printf '%q' "$root/$spec") ${lf[@]+"${lf[@]}"} "$f")
  [ -n "$spec" ] && [ -r "$root/$spec" ] || out="$out${out:+$'\n'}$f:1: Spec: ${spec:-(none)} cannot be read from $root. Fix: set Spec: to the spec path from the repo root."
  if grep -q '^Verdict:' "$f"; then
    ln=$(grep -n -m1 '^Range:' "$f" | cut -d: -f1)
    end=$(sed -n "${ln:-0}s/^Range:.*\.\.\.\([^ ]*\).*/\1/p" "$f" | tr -d '`')
    if ! git -C "$root" rev-parse -q --verify "${end:-none}^{commit}" >/dev/null || [ "$end" = HEAD ]; then
      out="$out${out:+$'\n'}$f:${ln:-1}: Range end ${end:-(none)} is not a commit sha. Fix: write Range: <BASE>...<HEAD sha> with the sha the review ran at."
    elif ! git -C "$root" merge-base --is-ancestor "$end" "$head"; then
      out="$out${out:+$'\n'}$f:$ln: Range end ${end:0:9} is not an ancestor of $head. Fix: re-run /final-review $spec at this branch."
    else
      changed=$(git -C "$root" diff --name-only "$end" "$head" | grep -vE "\.md\$|(^|/)docs/|$test_re" | head -n 5 | paste -sd, - | sed 's/,/, /g')
      [ -z "$changed" ] || out="$out${out:+$'\n'}$f:$ln: $changed changed since the Range end ${end:0:9}. Fix: re-run /final-review $spec (a delta run covers only these)."
    fi
  fi
  [ -z "$out" ] || { printf '%s\n' "$out"; exit 1; }
}

questions() {
  [ -r "$1" ] || { echo "$1: cannot read"; exit 2; }
  awk -v f="$1" '
    /^## / { sec=substr($0, 4); sub(/ +$/, "", sec); if (sec == "Open questions") at=FNR; next }
    sec == "Open questions" && ($0 ~ /^-? *none *$/ || $0 ~ /^- Q[0-9]+:/) { has=1 }
    sec == "Open questions" && /^- Q[0-9]+:/ && $0 !~ / Answer: *[^ ]/ { q=$2; sub(/:$/, "", q)
      printf "%s:%d: %s has no answer. Fix: send %s to the decision agent (skills/build/references/decide.md) and record its answer on that line as \"Answer: <answer>\".\n", f, FNR, q, q; bad=1 }
    END { if (bad) exit 1; if (!has) { printf "%s:%d: no \"## Open questions\" section. Fix: list every choice the spec leaves open or contradicts as \"- Q<n>: <question> Answer: <answer>\", send each to the decision agent (skills/build/references/decide.md), and write \"none\" when there are none.\n", f, at ? at : 1; exit 1 } }' "$1"
}

parts() {
  local f=$1 spec rows; load "$f"
  spec=$(dirname "$f")/spec.md
  [ -r "$spec" ] || { echo "$f:1: no spec.md next to the index"; exit 2; }
  printf '%s\n' "$rows" | awk -F'\t' -v f="$f" -v spec="$spec" -v AC='US-[0-9]+[.]AC[0-9]+[a-z]?' '
    FNR == 1 { fi++ }
    fi == 1 { if (NF) { rid[++nr]=$1; rln[$1]=$4; isdone[$1]=($3 ~ /^done /); m=split($2, b, ","); for (j=1; j<=m; j++) reach[$1, b[j]]=1 }; next }
    fi == 2 { if (match($0, "^- " AC ":")) { a=substr($0, 3, RLENGTH - 3); sa[++ns]=a; sln[a]=FNR }; next }
    /^## / { sec=substr($0, 4); sub(/ +$/, "", sec); next }
    sec == "Parts" && /^- [A-Z][0-9]+:/ { id=$0; sub(/^- /, "", id); sub(/:.*/, "", id); pln[id]=FNR; pid[++np]=id
      t=$0; sub(/^.*; *files: */, "", t); gsub(/`/, "", t); m=split(t, w, / *, */)
      for (j=1; j<=m; j++) if (w[j] != "") { k=++nf; fid[k]=id; fpath[k]=w[j]; fln[k]=FNR }
      t=$0; sub(/^- [^:]*:/, "", t); sub(/; *files:.*/, "", t)
      while (match(t, AC)) { a=substr(t, RSTART, RLENGTH); t=substr(t, RSTART + RLENGTH)
        if (a in in_) { printf "%s:%d: %s is listed under %s and %s. Fix: leave it in one of them.\n", f, FNR, a, in_[a], id; bad=1 }
        else in_[a]=id; n[id]++ }
      if (n[id] > 13) { printf "%s:%d: %s lists %d ACs. Fix: split it so no part has more than 13.\n", f, FNR, id, n[id]; bad=1 } }
    END {
      for (i=1; i<=nr; i++) if (!(rid[i] in pln)) { printf "%s:%d: %s has a row but no line under \"## Parts\". Fix: add \"- %s: <AC ids>; files: <paths it owns>\", or delete its row.\n", f, rln[rid[i]], rid[i], rid[i]; bad=1 }
      for (i=1; i<=np; i++) if (!(pid[i] in rln)) { printf "%s:%d: %s has a line under \"## Parts\" but no row. Fix: add its row to the table, or delete the line.\n", f, pln[pid[i]], pid[i]; bad=1 }
      for (i=1; i<=ns; i++) if (!(sa[i] in in_)) { printf "%s:%d: %s is in no part. Fix: add it to exactly one part'"'"'s line under \"## Parts\" in %s.\n", spec, sln[sa[i]], sa[i], f; bad=1 }
      for (u in rln) for (v in rln) for (x in rln) if (reach[v, u] && reach[u, x]) reach[v, x]=1
      for (i=1; i<=nf; i++) for (j=i+1; j<=nf; j++) { u=fid[i]; v=fid[j]
        if (u == v || fpath[i] != fpath[j] || reach[u, v] || reach[v, u] || isdone[u] || isdone[v]) continue
        printf "%s:%d: %s and %s both list %s, and neither is blocked by the other. Fix: give the file to one part, or order the two (one blocked by the other).\n", f, fln[j], u, v, fpath[i]; bad=1 }
      exit bad
    }' - "$spec" "$f"
}

entry() {
  local s=$1 w after ws x q=
  s=${s#"${s%%[![:space:]]*}"}; s=${s%"${s##*[![:space:]]}"}
  case $s in \"*) s=${s#\"}; q=1 ;; esac
  w=${s%%[[:space:]\"]*}
  [ -n "$w" ] || { echo "wf entry: no argument. Fix: give the path of an approved spec or a quoted one-line task (\"<task>\")."; exit 1; }
  [ -f "$w" ] && { echo spec; return 0; }
  case $w in *.md) echo "wf entry: $w is not a file. Fix: correct the path, or quote a one-line task (\"<task>\")."; exit 1 ;; esac
  if [ -n "$q" ] && [ "$s" != "${s#*\"}" ]; then
    after=${s#*\"}; read -ra ws <<<"$after"
  else
    read -ra ws <<<"$s"; ws=("${ws[@]: -1}")
  fi
  for x in ${ws[@]+"${ws[@]}"}; do
    [ "$x" != AFK ] || { echo "wf entry: a one-line task cannot run AFK. Fix: a one-line task needs the owner's approval, so run it attended or pass an approved spec."; exit 1; }
  done
  echo task
}

commit() { # commit <index> <message>: commit only the index
  git -C "$(dirname "$1")" commit -q -m "$2" -- "$(basename "$1")" || { echo "$1: commit failed"; exit 2; }
}

set_status() { # set_status <index> <id> <status>
  local rows tmp; load "$1"
  printf '%s\n' "$rows" | cut -f1 | grep -qFx -- "$2" || { echo "$1: no ticket $2"; exit 2; }
  tmp=$(mktemp) || exit 2
  awk -F'|' -v OFS='|' -v id="$2" -v st="$3" '
    { t=$2; gsub(/^ +| +$/, "", t) }
    t == id && NF >= 6 { $(NF-1)=" " st " " }
    { print }' "$1" > "$tmp" && cat "$tmp" > "$1"; rm -f "$tmp"
  case $3 in done\ *) commit "$1" "docs(build): $2 done" ;; *) commit "$1" "docs(build): $2 $3" ;; esac
}

ruling() { # ruling <index> <text>: append "- <date>, <text>" to the Rulings section
  local tmp
  [ -r "$1" ] || { echo "$1: cannot read"; exit 2; }
  grep -q '^## Rulings' "$1" || { echo "$1: no ## Rulings section"; exit 2; }
  tmp=$(mktemp) || exit 2
  awk -v line="- $(date +%F), $2" '
    function add() { if (n && lines[n] == "") { n--; blank=1 }; for (i=1; i<=n; i++) print lines[i]; print line; if (blank) print ""; n=0; done_=1 }
    /^## Rulings/ { inr=1; print; next }
    inr && /^## / { add(); inr=0 }
    inr { if ($0 ~ /^<Decisions made/) next; lines[++n]=$0; next }
    { print }
    END { if (inr) add() }' "$1" > "$tmp" && cat "$tmp" > "$1"; rm -f "$tmp"
  commit "$1" "docs(build): ruling"
}

mode() {
  local conf=${CHECKS_CONF:-$(cd "$(dirname "$0")/.." && pwd)/checks.conf} v line
  case $1 in delivers) v=block ;; *) v=warn ;; esac
  if [ -r "$conf" ]; then
    line=$(grep -E "^$1=" "$conf" | tail -n 1)
    [ -z "$line" ] || v=${line#*=}
  fi
  case $v in warn|block) echo "$v" ;;
    *) echo "ERROR $conf: $1=$v is not warn or block. Fix: set $1=warn or $1=block in $conf."; exit 2 ;;
  esac
}

cmd=${1:-}; shift || true
case $cmd in
  base) [ $# -eq 0 ] || { echo "usage: wf base"; exit 2; }; repo_base ;;
  frontier) [ $# -eq 1 ] || { echo "usage: wf frontier <index.md>"; exit 2; }; frontier "$1" ;;
  chains) [ $# -eq 1 ] || { echo "usage: wf chains <index.md>"; exit 2; }; chains "$1" ;;
  waves) [ $# -eq 1 ] || { echo "usage: wf waves <index.md>"; exit 2; }; waves "$1" ;;
  check-plan) [ $# -eq 1 ] || { echo "usage: wf check-plan <index.md>"; exit 2; }; check_plan "$1" ;;
  check-spec) [ $# -eq 1 ] || { echo "usage: wf check-spec <spec.md>"; exit 2; }; check_spec "$1" ;;
  parts) [ $# -eq 1 ] || { echo "usage: wf parts <index.md>"; exit 2; }; parts "$1" ;;
  questions) [ $# -eq 1 ] || { echo "usage: wf questions <index.md>"; exit 2; }; questions "$1" ;;
  entry) [ $# -le 1 ] || { echo "usage: wf entry '<raw argument>'"; exit 2; }; entry "${1:-}" ;;
  gate)
    [ $# -eq 1 ] || { [ $# -eq 2 ] && case $2 in --build|--final|--slice|--direct|--task) true ;; *) false ;; esac; } ||
      { echo "usage: wf gate <spec|index.md> [--build|--final|--slice|--direct|--task]"; exit 2; }
    gate "$@" ;;
  scope) [ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: wf scope <index.md> [head]"; exit 2; }; scope "$@" ;;
  check-review) [ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: wf check-review <review.md> [head]"; exit 2; }; check_review "$@" ;;
  lead) [ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: wf lead <index.md> [head]"; exit 2; }; lead "$@" ;;
  red) [ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: wf red <spec.md> [head]"; exit 2; }; red "$@" ;;
  size) [ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: wf size <index.md> [head]"; exit 2; }; size "$@" ;;
  set)
    [ $# -eq 3 ] || { echo 'usage: wf set <index.md> <id> todo|doing|"blocked: <reason>"'; exit 2; }
    case $3 in todo|doing|"blocked: "?*) ;; *) echo "bad status: $3 (todo, doing, blocked: <reason>; use wf done for done)"; exit 2 ;; esac
    set_status "$@" ;;
  done)
    [ $# -eq 3 ] || { echo "usage: wf done <index.md> <id> <merge sha>"; exit 2; }
    sha=$(git -C "$(dirname "$1")" rev-parse -q --verify "$3^{commit}") || { echo "not a commit: $3"; exit 2; }
    set_status "$1" "$2" "done ${sha:0:8}" ;;
  ruling) [ $# -eq 2 ] && [ -n "$2" ] || { echo 'usage: wf ruling <index.md> "<text>"'; exit 2; }; ruling "$@" ;;
  mode)
    case "$*" in delivers|wording|guard-patch) ;; *) echo "usage: wf mode delivers|wording|guard-patch"; exit 2 ;; esac
    mode "$1" ;;
  warn-log)
    [ $# -eq 4 ] || { echo 'usage: wf warn-log <feature-dir> <check> <ticket-id> "<subject>: <text>"'; exit 2; }
    line="$2 $3 $4"
    if gd=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
      mkdir -p "$gd/info"
      grep -qxF check-warnings.log "$gd/info/exclude" 2>/dev/null || echo check-warnings.log >> "$gd/info/exclude"
    fi
    grep -Fxq -- "$line" "$1/check-warnings.log" 2>/dev/null || printf '%s\n' "$line" >> "$1/check-warnings.log" ;;
  *) echo "usage: wf base|frontier|chains|waves|check-plan|check-spec|questions|parts|entry|check-review|gate|scope|red|lead|size|set|done|ruling|mode|warn-log <index.md> ..."; exit 2 ;;
esac
